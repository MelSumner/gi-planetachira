# Optional: enables the "All characters" roster via the unofficial HoYoLAB API.
# These cookies grant access to your HoYoLAB account. Never commit .env.
#
# How to get them:
#   1. Log in at https://www.hoyolab.com in your browser.
#   2. Open DevTools → Application (Chrome) / Storage (Firefox) → Cookies → https://www.hoyolab.com
#   3. Copy the values of ltuid_v2, ltoken_v2 and ltmid_v2 into the line below.
HOYOLAB_COOKIE="ltuid_v2=; ltoken_v2=; ltmid_v2="

# Optional overrides
# GENSHIN_UID=635783945
# PORT=3000
